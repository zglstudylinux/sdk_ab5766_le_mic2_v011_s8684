<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="app" />
		<Option pch_mode="2" />
		<Option compiler="riscv32-v3" />
		<Build>
			<Target title="Debug">
				<Option output="Output/bin/app.rv32" prefix_auto="1" extension_auto="0" />
				<Option object_output="Output/obj/" />
				<Option type="1" />
				<Option compiler="riscv32-v3" />
			</Target>
		</Build>
		<Compiler>
			<Add option="-Os" />
			<Add option="-Wall" />
			<Add option="-march=rv32imc_zba_zbb_zbc_zbs_zca_zcb_zcmp_xbs1" />
			<Add option="-Wno-array-bounds" />
			<Add option="-Wno-address-of-packed-member" />
			<Add option="-ffunction-sections" />
			<Add option="-mjump-tables-in-text" />
			<Add directory="." />
			<Add directory="../../header" />
			<Add directory="../../libs" />
			<Add directory="../../libs/ble" />
			<Add directory="../../libs/cpu" />
			<Add directory="../../libs/usb" />
			<Add directory="../../driver" />
			<Add directory="../../modules/fota" />
			<Add directory="../../modules/utils" />
			<Add directory="../../modules/ble" />
			<Add directory="../../modules/audio/dec" />
			<Add directory="production_test" />
			<Add directory="production_test/iodm" />
			<Add directory="production_test/tbox" />
			<Add directory="../../functions" />
			<Add directory="../../bsp" />
			<Add directory="../../modules" />
			<Add directory="../../modules/wireless" />
		</Compiler>
		<Linker>
			<Add option="-T$(TARGET_OBJECT_DIR)ram.o" />
			<Add option="--gc-sections" />
			<Add option="-Map=Output\bin\map.txt" />
			<Add option="--no-warn-rwx-segments" />
			<Add library="../../libs/cpu/libplatform.a" />
			<Add library="../../libs/cpu/libm.a" />
			<Add library="../../libs/cpu/libc.a" />
			<Add library="../../libs/cpu/libgcc.a" />
			<Add library="../../libs/ble/libbtstack.a" />
		</Linker>
		<ExtraCommands>
			<Add before="Output\bin\prebuild.bat $(PROJECT_NAME)" />
			<Add after="Output\bin\postbuild.bat $(PROJECT_NAME)" />
		</ExtraCommands>
